{
  "$defs": {
    "AttackMapping": {
      "additionalProperties": false,
      "description": "Final, catalog-validated mapping (code fills tactic/name from the catalog, spec 06).",
      "properties": {
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "tactic": {
          "title": "Tactic",
          "type": "string"
        },
        "tactic_id": {
          "pattern": "^TA\\d{4}$",
          "title": "Tactic Id",
          "type": "string"
        },
        "technique_id": {
          "pattern": "^T\\d{4}(\\.\\d{3})?$",
          "title": "Technique Id",
          "type": "string"
        },
        "technique_name": {
          "title": "Technique Name",
          "type": "string"
        }
      },
      "required": [
        "tactic_id",
        "tactic",
        "technique_id",
        "technique_name",
        "confidence",
        "evidence"
      ],
      "title": "AttackMapping",
      "type": "object"
    },
    "Briefing": {
      "additionalProperties": false,
      "description": "LLM structured output for the briefing node (spec 07) \u2014 also the final output block.",
      "properties": {
        "markdown": {
          "minLength": 1,
          "title": "Markdown",
          "type": "string"
        }
      },
      "required": [
        "markdown"
      ],
      "title": "Briefing",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "is_internal": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Internal"
        },
        "provenance": {
          "$ref": "#/$defs/EntityProvenance"
        },
        "role": {
          "default": "unknown",
          "enum": [
            "source",
            "destination",
            "actor",
            "target",
            "unknown"
          ],
          "title": "Role",
          "type": "string"
        },
        "type": {
          "enum": [
            "ip",
            "domain",
            "url",
            "hash_md5",
            "hash_sha1",
            "hash_sha256",
            "email",
            "user",
            "host",
            "process",
            "file_path"
          ],
          "title": "Type",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value",
        "confidence",
        "provenance"
      ],
      "title": "Entity",
      "type": "object"
    },
    "EntityProvenance": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "method": {
          "enum": [
            "field_map",
            "regex",
            "llm"
          ],
          "title": "Method",
          "type": "string"
        },
        "original_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Text"
        }
      },
      "required": [
        "method"
      ],
      "title": "EntityProvenance",
      "type": "object"
    },
    "EntityRef": {
      "additionalProperties": false,
      "description": "Minimal (type, value) reference \u2014 used inside TIResult.",
      "properties": {
        "type": {
          "enum": [
            "ip",
            "domain",
            "url",
            "hash_md5",
            "hash_sha1",
            "hash_sha256",
            "email",
            "user",
            "host",
            "process",
            "file_path"
          ],
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "NormalizationInfo": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "method": {
          "enum": [
            "parser",
            "llm"
          ],
          "title": "Method",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "method",
        "confidence"
      ],
      "title": "NormalizationInfo",
      "type": "object"
    },
    "NormalizedAlert": {
      "additionalProperties": false,
      "properties": {
        "alert_id": {
          "minLength": 1,
          "title": "Alert Id",
          "type": "string"
        },
        "category": {
          "anyOf": [
            {
              "enum": [
                "malware",
                "phishing",
                "command_and_control",
                "lateral_movement",
                "exfiltration",
                "credential_access",
                "initial_access",
                "persistence",
                "reconnaissance",
                "policy_violation",
                "anomaly",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "dedupe_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dedupe Key",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        },
        "normalization": {
          "$ref": "#/$defs/NormalizationInfo"
        },
        "observed_fields": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Observed Fields",
          "type": "object"
        },
        "occurred_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurred At"
        },
        "raw": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "string"
            }
          ],
          "title": "Raw"
        },
        "severity": {
          "maximum": 100,
          "minimum": 0,
          "title": "Severity",
          "type": "integer"
        },
        "severity_original": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity Original"
        },
        "source_system": {
          "enum": [
            "generic",
            "splunk",
            "elastic",
            "cef",
            "freetext"
          ],
          "title": "Source System",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "vendor_rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vendor Rule"
        }
      },
      "required": [
        "alert_id",
        "dedupe_key",
        "source_system",
        "title",
        "severity",
        "ingested_at",
        "raw",
        "normalization"
      ],
      "title": "NormalizedAlert",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "agent_version": {
          "title": "Agent Version",
          "type": "string"
        },
        "duration_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "history_store": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "History Store"
        },
        "models": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Models",
          "type": "object"
        },
        "stage_timings_ms": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Stage Timings Ms",
          "type": "object"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "ti_providers": {
          "items": {
            "type": "string"
          },
          "title": "Ti Providers",
          "type": "array"
        },
        "token_usage": {
          "$ref": "#/$defs/TokenUsage"
        }
      },
      "required": [
        "agent_version",
        "started_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
